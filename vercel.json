{
  "framework": null,
  "buildCommand": "npm run build --prefix browser-app",
  "outputDirectory": "browser-app/dist",
  "functions": {
    "api/query.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "installCommand": "npm ci --prefix browser-app"
}